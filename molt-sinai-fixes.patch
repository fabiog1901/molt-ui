new file mode 100644
index 0000000..3f84c6a
--- /dev/null
+++ b/fetch/schema_creation_excluded_type_test.go
@@ -0,0 +1,95 @@
+package fetch
+
+import (
+	"context"
+	"testing"
+
+	"github.com/cockroachdb/molt/dbconn"
+	"github.com/cockroachdb/molt/dbtable"
+	"github.com/cockroachdb/molt/fetch/transforms"
+	"github.com/cockroachdb/molt/testutils"
+	"github.com/rs/zerolog"
+	"github.com/stretchr/testify/require"
+)
+
+// Excluded columns can have types unsupported by CockroachDB. Computed-column
+// setup must not try to convert those types unless it will re-add the column.
+func TestGetAlterTableComputedStatementsExcludedUnsupportedType(t *testing.T) {
+	ctx := context.Background()
+	const dbName = "molt_excluded_type_regression"
+	source, err := dbconn.TestOnlyCleanDatabase(ctx, "source", testutils.PGConnStr(), dbName)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		require.NoError(t, source.Close(ctx))
+		require.NoError(t, dbconn.TestOnlyDropDatabase(ctx, "source", testutils.PGConnStr(), dbName))
+	})
+	_, err = source.(*dbconn.PGConn).Exec(ctx, `CREATE TABLE addresses (
+		id INT PRIMARY KEY,
+		coordinates POINT,
+		available_during INT4RANGE,
+		delivery_window TSTZRANGE,
+		coordinates_x FLOAT8 GENERATED ALWAYS AS (coordinates[0]) STORED
+	)`)
+	require.NoError(t, err)
+	name := dbtable.Name{Schema: "public", Table: "addresses"}
+	table := dbtable.DBTable{Name: name, RenamedTo: name}
+	for _, tc := range []struct {
+		name    string
+		columns map[string]transforms.ColumnDetails
+		wantDDL bool
+		wantErr bool
+	}{
+		{
+			name: "plain exclusions",
+			columns: map[string]transforms.ColumnDetails{
+				"coordinates": {}, "available_during": {}, "delivery_window": {},
+			},
+		},
+		{
+			name: "computed column not requested",
+			columns: map[string]transforms.ColumnDetails{
+				"coordinates": {IsComputed: true, ShouldApplyComputed: false},
+			},
+		},
+		{
+			name: "noncomputed column with apply flag",
+			columns: map[string]transforms.ColumnDetails{
+				"coordinates": {IsComputed: false, ShouldApplyComputed: true},
+			},
+		},
+		{
+			name: "mixed exclusions and computed column",
+			columns: map[string]transforms.ColumnDetails{
+				"coordinates":   {},
+				"coordinates_x": {IsComputed: true, ShouldApplyComputed: true, ComputedExpression: "id::FLOAT8"},
+			},
+			wantDDL: true,
+		},
+		{
+			name: "unsupported computed column still fails",
+			columns: map[string]transforms.ColumnDetails{
+				"coordinates": {IsComputed: true, ShouldApplyComputed: true, ComputedExpression: "NULL"},
+			},
+			wantErr: true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			stmts, err := GetAlterTableComputedStatements(ctx, zerolog.Nop(),
+				dbconn.OrderedConns{source, nil}, []dbtable.DBTable{table}, nil,
+				transforms.TableExcludedColumnMap{name: tc.columns})
+			if tc.wantErr {
+				require.ErrorContains(t, err, "Unknown OID")
+				return
+			}
+			require.NoError(t, err)
+			if tc.wantDDL {
+				require.Len(t, stmts, 1)
+				require.Contains(t, stmts[0], "ADD COLUMN coordinates_x FLOAT8")
+				require.Contains(t, stmts[0], "AS (id::FLOAT8) STORED")
+				require.NotContains(t, stmts[0], "ADD COLUMN coordinates ")
+			} else {
+				require.Empty(t, stmts)
+			}
+		})
+	}
+}
