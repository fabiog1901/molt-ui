+func TestExcludedColumnLogSeverity(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		tag         string
+		excluded    bool
+		wantLevel   string
+		wantErr     bool
+		wantWarning bool
+	}{
+		{name: "intentional exclusion", tag: inconsistency.MismatchTargetMissingColumn, excluded: true, wantLevel: "info"},
+		{name: "unexpected missing column", tag: inconsistency.MismatchTargetMissingColumn, wantLevel: "error", wantErr: true},
+		{name: "excluded column with unrelated mismatch", tag: inconsistency.MismatchColumnType, excluded: true, wantLevel: "error", wantErr: true},
+		{name: "other nonblocking mismatch", tag: inconsistency.MismatchTargetExtraneousColumn, wantLevel: "error", wantWarning: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			name := dbtable.Name{Schema: "order_demo", Table: "addresses"}
+			exclusions := transforms.TableExcludedColumnMap{}
+			if tc.excluded {
+				exclusions[name] = map[string]transforms.ColumnDetails{"coordinates": {}}
+			}
+			result := makeResult("order_demo", "addresses", inconsistency.MismatchingTableDefinition{
+				Tag: tc.tag, ColumnName: "coordinates", Info: "missing column coordinates on target",
+			})
+			err := columns.CheckForColumnMismatches(zerolog.New(&buf).Level(zerolog.InfoLevel), exclusions, []tableverify.Result{result})
+			require.Equal(t, tc.wantErr, err != nil)
+			var logs []map[string]any
+			for _, line := range strings.Split(strings.TrimSpace(buf.String()), "\n") {
+				var entry map[string]any
+				require.NoError(t, json.Unmarshal([]byte(line), &entry))
+				logs = append(logs, entry)
+			}
+			require.Equal(t, tc.wantLevel, logs[0]["level"])
+			if tc.wantWarning {
+				require.Len(t, logs, 2)
+				require.Equal(t, "warn", logs[1]["level"])
+			} else {
+				require.Len(t, logs, 1)
+			}
+			if tc.wantLevel == "info" {
+				require.Equal(t, "not migrating explicitly excluded column order_demo.addresses.coordinates", logs[0]["message"])
+				require.Equal(t, true, logs[0]["col_exclusion"])
+				require.Equal(t, false, logs[0]["failable_mismatch"])
+			}
+		})
+	}
+}
